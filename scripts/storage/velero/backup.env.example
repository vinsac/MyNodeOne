# Velero backup destination.
#
# Copy this file somewhere outside the repo, edit it, and pass it with
#   sudo ./scripts/storage/velero/configure-backup.sh --config /path/to/backup.env
# Environment variables with the same names take precedence over this file.
#
# There is no default destination. configure-backup.sh stops if none is set.

# Required. "s3" for any S3-compatible service, or "minio" for a MinIO instance in
# this cluster. A MinIO instance on the same machine doesn't survive losing that
# machine, so prefer an off-machine "s3" target.
VELERO_BACKUP_TARGET=

# --- Needed for VELERO_BACKUP_TARGET=s3 ---
# VELERO_S3_URL=https://s3.example.com
# VELERO_BUCKET=my-cluster-backups
# VELERO_REGION=us-east-1
# AWS-style credentials file with [default], aws_access_key_id, aws_secret_access_key.
# VELERO_CREDENTIALS_FILE=/root/velero-s3-credentials

# --- Needed for VELERO_BACKUP_TARGET=minio ---
# The node MinIO runs on. Optional only when the cluster has exactly one instance.
# VELERO_MINIO_NODE=my-node
# The bucket must already exist.
# VELERO_BUCKET=velero-backups
# Optional. Without this, Velero uses MinIO's root credentials.
# VELERO_CREDENTIALS_FILE=/root/velero-minio-credentials

# --- Optional ---
# VELERO_PREFIX=my-cluster
# VELERO_FULL_RETENTION_DAYS=180
# VELERO_DAILY_RETENTION_DAYS=30
# VELERO_FULL_SCHEDULE=0 2 1 * *
# VELERO_DAILY_SCHEDULE=0 2 * * *
# Leave false unless a CSI snapshot setup exists. See configure-backup.sh.
# VELERO_SNAPSHOT_VOLUMES=false
